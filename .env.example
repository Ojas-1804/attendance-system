# Copy to backend/.env and change the values. Never commit the real .env
DATABASE_URL=postgresql+psycopg://attendance:change_me@localhost:5432/attendance
JWT_SECRET=replace-with-a-long-random-string
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change_me
POSTGRES_DB=attendance

# Optional
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=*
